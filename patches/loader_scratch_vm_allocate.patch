+// Tensor-sized scratch memory. libmalloc can keep a freed large block in the
+// process footprint (leehack/llamadart#2004); vm_deallocate returns it at once.
+// Unlike a vector, growing keeps no contents.
+class TensorScratch {
+public:
+    TensorScratch()                                = default;
+    TensorScratch(const TensorScratch&)            = delete;
+    TensorScratch& operator=(const TensorScratch&) = delete;
+    ~TensorScratch() {
+        release();
+    }
+
+    void resize(size_t size) {
+        if (size <= capacity_) {
+            return;
+        }
+        const size_t capacity = std::max(size, 2 * capacity_);
+        release();
+        vm_address_t address = 0;
+        if (vm_allocate(mach_task_self(), &address, capacity, VM_FLAGS_ANYWHERE) != KERN_SUCCESS) {
+            throw std::bad_alloc();
+        }
+        data_     = (uint8_t*)address;
+        capacity_ = capacity;
+    }
+
+    uint8_t* data() {
+        return data_;
+    }
+
+private:
+    void release() {
+        if (data_ != nullptr) {
+            vm_deallocate(mach_task_self(), (vm_address_t)data_, capacity_);
+        }
+        data_     = nullptr;
+        capacity_ = 0;
+    }
+
+    uint8_t* data_   = nullptr;
+    size_t capacity_ = 0;
+};
+#else
+using TensorScratch = std::vector<uint8_t>;
+#endif
 
