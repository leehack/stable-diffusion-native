+struct ZipEntryLookup {
+    struct Entry { int index; uint64_t size; };
+    // Keep the first normalized name, as a fresh archive-order scan would.
+    std::unordered_map<std::string, Entry> entries;
+    size_t scanned = 0;
+};
+
+static bool find_zip_entry(zip_t* zip, ZipEntryLookup& lookup, const std::string& entry_name, int* index, uint64_t* size) {
+    auto found = lookup.entries.find(entry_name);
+    if (found != lookup.entries.end()) {
+        *index = found->second.index;
+        *size = found->second.size;
+        return true;
+    }
+    const size_t n = static_cast<size_t>(zip_entries_total(zip));
+    while (lookup.scanned < n) {
+        size_t i = lookup.scanned++;
+        if (zip_entry_openbyindex(zip, i) != 0) {
+            zip_entry_close(zip);
+            return false;
+        }
+        const char* raw_name = zip_entry_name(zip);
+        if (raw_name == nullptr) {
+            zip_entry_close(zip);
+            return false;
+        }
+        std::string name = raw_name;
+        uint64_t entry_size = zip_entry_size(zip);
+        lookup.entries.emplace(name, ZipEntryLookup::Entry{(int)i, entry_size});
+        zip_entry_close(zip);
         if (name == entry_name) {
             *index = (int)i;
-            *size  = zip_entry_size(zip);
-            zip_entry_close(zip);
+            *size = entry_size;
             return true;
         }
-        zip_entry_close(zip);
     }
     return false;
 }
