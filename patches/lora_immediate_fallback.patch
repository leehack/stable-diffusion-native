+// Applying a LoRA immediately adds an F32 diff into each F16 weight in place, on
+// the backend holding the weight. ggml-metal adds only equal types, and the
+// scheduler aborts on an op a pre-allocated tensor's backend cannot run, unless
+// the tensor is in host memory, where the CPU runs it. Every model has F16
+// weights: convolutions load as F16 whatever the file holds.
+static bool backend_adds_f32_into_f16(ggml_backend_t backend) {
+    if (ggml_backend_buft_is_host(ggml_backend_get_default_buffer_type(backend))) {
+        return true;
+    }
+    ggml_init_params params = {8 * ggml_tensor_overhead(), nullptr, true};
+    ggml_context* ctx       = ggml_init(params);
+    if (ctx == nullptr) {
+        return false;
+    }
+    ggml_tensor* weight  = ggml_new_tensor_1d(ctx, GGML_TYPE_F16, 16);
+    ggml_tensor* diff    = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 16);
+    const bool supported = ggml_backend_supports_op(backend, ggml_add_inplace(ctx, weight, diff));
+    ggml_free(ctx);
+    return supported;
+}
