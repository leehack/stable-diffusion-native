+// A legacy checkpoint passes the rest of the file, tensor storage included, so
+// the span can exceed INT_MAX. No pickle line is that long.
+static int find_line_end(const uint8_t* p, const uint8_t* end) {
+    const ptrdiff_t max_len = std::numeric_limits<int>::max();
+    return find_char(p, (int)std::min(end - p, max_len), '\n');
+}
